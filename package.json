{
  "name": "dong-app",
  "version": "1.0.0",
  "description": "Node.js backend with PostgreSQL and Redis",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "bank": "node src/bank.js",
    "build:bank": "pkg src/bank.js --out-path dist"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node22-linux-x64",
      "node22-macos-arm64",
      "node22-win-x64"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^4.19.2",
    "multer": "^2.1.1",
    "papaparse": "^5.5.3",
    "pg": "^8.12.0",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.20.0"
  }
}
